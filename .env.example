# Defaults for every checkout. `node scripts/checkout-env.mjs --write` writes .env with this
# checkout's own ports and database names on top of these values.
NODE_ENV=development
API_PORT=3000
WEB_PORT=5173
DRIVER_PORT=5174
# The browser's origin: the Vite dev server, which proxies /api to the API (ADR-0003).
APP_ORIGIN=http://localhost:5173
# The API and the job runner connect as rampflow_app (NOBYPASSRLS, owns nothing).
DATABASE_URL=postgres://rampflow_app:rampflow_app@localhost:5432/rampflow
# Migrations, `pnpm db:setup` and test fixtures connect as the owner role.
MIGRATION_DATABASE_URL=postgres://rampflow:rampflow@localhost:5432/rampflow
# HMAC key for emailed and driver tokens; at least 32 characters, required in production.
TOKEN_SECRET=dev-only-token-secret-change-me-0000
# 1 behind a reverse proxy: rate limits key on the last X-Forwarded-For entry.
TRUST_PROXY=0
ENABLE_JOBS=1
ENABLE_TEST_ROUTES=0
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=rampflow <no-reply@rampflow.local>
