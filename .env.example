# Defaults for every checkout. `node scripts/checkout-env.mjs --write` writes .env with this
# checkout's own ports and database names on top of these values.
# Unset means production: the dev TOKEN_SECRET, ENABLE_TEST_ROUTES=1 and ENABLE_API_DOCS=1 are
# refused, cookies are Secure.
NODE_ENV=development
API_PORT=3000
WEB_PORT=5173
DRIVER_PORT=5174
# The browser's origin, the only one the API accepts writes from (ADR-0003). Production sets it.
# Dev derives it as http://<DEV_HOST>:<WEB_PORT> (https with DEV_TLS_CERT and DEV_TLS_KEY) and accepts other
# addresses through APP_EXTRA_ORIGINS. DEV_HOST defaults to the LAN address; set it to override.
# APP_ORIGIN=https://rampflow.example.com
# DEV_HOST=dock-pc.local
# Trusted certificate and key paths, absolute or relative to the repo root, for LAN HTTPS.
# See docs/how-to/run-locally.md. Both must be set; e2e always uses localhost HTTP.
# DEV_TLS_CERT=/path/to/rampflow.pem
# DEV_TLS_KEY=/path/to/rampflow-key.pem
# The API and the job runner connect as rampflow_app (NOBYPASSRLS, owns nothing).
DATABASE_URL=postgres://rampflow_app:rampflow_app@localhost:5432/rampflow
# Migrations, `pnpm db:setup` and test fixtures connect as the owner role.
MIGRATION_DATABASE_URL=postgres://rampflow:rampflow@localhost:5432/rampflow
# HMAC key for emailed and driver tokens; at least 32 characters, required in production.
TOKEN_SECRET=dev-only-token-secret-change-me-0000
# 1 behind a reverse proxy: rate limits key on the last X-Forwarded-For entry.
TRUST_PROXY=0
ENABLE_JOBS=1
ENABLE_TEST_ROUTES=0
# Swagger UI at <APP_ORIGIN>/api/docs and the document at /api/openapi.json; refused in production.
ENABLE_API_DOCS=1
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=rampflow <no-reply@rampflow.local>
# The EC's VIES REST API for the tax id check job. Empty: no request leaves the API. Unset in
# production means https://ec.europa.eu/taxation_customs/vies/rest-api.
VIES_URL=
