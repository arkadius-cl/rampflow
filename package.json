{
  "name": "rampflow",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"pnpm --filter @rampflow/api dev\" \"pnpm --filter @rampflow/web dev\"",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "test:e2e:container": "podman run --rm --network host --ipc host -v \"$PWD\":/work -w /work mcr.microsoft.com/playwright:v1.64.1-noble npx playwright test",
    "db:up": "podman compose up -d --wait",
    "db:down": "podman compose down",
    "docs:index": "node scripts/docs.mjs index",
    "docs:check": "node scripts/docs.mjs check",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm docs:check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "concurrently": "10.0.6",
    "typescript": "7.0.2"
  }
}
