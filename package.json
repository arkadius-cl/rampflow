{
  "name": "rampflow",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"pnpm --filter @rampflow/api dev\" \"pnpm --filter @rampflow/web dev\"",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p e2e",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "pnpm -r test",
    "test:e2e": "node scripts/checkout-env.mjs run -- sh -c 'podman run --rm --network host --ipc host -e API_PORT -e WEB_PORT -e DRIVER_PORT -e APP_ORIGIN -e DATABASE_URL -e MIGRATION_DATABASE_URL -e SMTP_HOST -e SMTP_PORT -e CI -v \"$PWD\":/work:z -w /work mcr.microsoft.com/playwright:v1.64.1-noble node_modules/.bin/playwright test \"$@\"' sh",
    "test:e2e:host": "node scripts/checkout-env.mjs run -- playwright test",
    "db:up": "podman compose up -d --wait --no-recreate",
    "db:down": "podman compose down",
    "db:setup": "pnpm --filter @rampflow/api db:setup",
    "db:migrate": "pnpm --filter @rampflow/api db:migrate",
    "db:reset": "pnpm --filter @rampflow/api db:reset",
    "db:generate": "pnpm --filter @rampflow/api db:generate",
    "db:regen": "pnpm --filter @rampflow/api db:regen",
    "db:seed": "pnpm --filter @rampflow/api db:seed",
    "admin:create": "pnpm --filter @rampflow/api admin:create",
    "checkout:env": "node scripts/checkout-env.mjs",
    "docs:index": "node scripts/docs.mjs index",
    "docs:check": "node scripts/docs.mjs check",
    "i18n:derive": "node scripts/i18n-derive.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm docs:check && pnpm i18n:derive --check",
    "bench": "BENCH=1 pnpm --filter @rampflow/api test bench.test",
    "ux:screens": "podman run --rm --network host --ipc host -v \"$PWD\":/work:z -w /work -e UX_SCREENS_OUT mcr.microsoft.com/playwright:v1.64.1-noble node scripts/ux-screens.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "@types/pg": "8.15.6",
    "concurrently": "10.0.6",
    "pg": "8.23.1",
    "typescript": "7.0.2"
  }
}
