{
  "name": "@rampflow/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/app.ts"
    }
  },
  "scripts": {
    "dev": "node ../../scripts/checkout-env.mjs run -- tsx watch src/server.ts",
    "start": "node ../../scripts/checkout-env.mjs run -- tsx src/server.ts",
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "node ../../scripts/checkout-env.mjs run -- vitest run",
    "db:setup": "node ../../scripts/checkout-env.mjs run -- tsx scripts/db-setup.ts",
    "db:migrate": "node ../../scripts/checkout-env.mjs run -- tsx scripts/db-setup.ts --migrate",
    "db:reset": "node ../../scripts/checkout-env.mjs run -- tsx scripts/db-setup.ts --reset",
    "db:generate": "tsx scripts/db-regen.ts",
    "db:regen": "tsx scripts/db-regen.ts",
    "admin:create": "node ../../scripts/checkout-env.mjs run -- tsx scripts/admin-create.ts",
    "db:seed": "node ../../scripts/checkout-env.mjs run -- tsx scripts/seed-dev.ts"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@hono/node-server": "2.1.5",
    "@hono/zod-validator": "0.9.1",
    "@rampflow/i18n": "workspace:*",
    "@rampflow/shared": "workspace:*",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.1.1",
    "date-fns": "4.4.0",
    "date-holidays": "3.37.0",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "i18next": "26.5.2",
    "nodemailer": "10.1.7",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.15.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
